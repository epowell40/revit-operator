REVIT_OPERATOR_MODE=local
OPERATOR_API_BASE_URL=http://127.0.0.1:7007
OPERATOR_HOSTED_ENABLED=false
OPERATOR_OPENAI_API_KEY=
OPENAI_API_KEY=
OPERATOR_TOKEN=

# Optional native-UI developer beta for explicit local qualification checkpoints.
# Set these in the backend process; do not pass them to Revit.
# OPERATOR_LOCAL_EXECUTOR_PROFILE=codex_v2_advisory_v1
# REVIT_OPERATOR_MODE=development
# OPERATOR_TOOL_EXPOSURE_PROFILE=laboratory
# OPERATOR_BRAIN=codex
# OPERATOR_ASSIGNMENT_KERNEL_V2=1
# OPERATOR_AUTH_MODE=shared_token
# Requires the existing authenticated shared token, loopback backend origin,
# OPERATOR_HOSTED_ENABLED=false and ready development/laboratory profile.
# Selects new document-bound tasks without per-session enrollment; it does not
# certify CLI/provider readiness, native writes or task completion.
