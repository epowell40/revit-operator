{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "Revit Operator MCP Server",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "npm run build && node --test dist/**/*.test.js",
    "external-agent": "node dist/cli/externalAgent.js",
    "evidence:epic-0437": "node --loader ts-node/esm src/scripts/run_epic_0437_live_evidence.ts",
    "acceptance:mep": "ts-node src/scripts/run_mep_continuity_acceptance.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/pdf-parse": "^1.1.5",
    "mammoth": "^1.11.0",
    "ml-random-forest": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
