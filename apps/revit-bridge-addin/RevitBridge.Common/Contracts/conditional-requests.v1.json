  "/revit/export-elements-xlsx": {
    "type": "object",
    "properties": {
      "elementIds": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "minItems": 1,
        "maxItems": 2000
      },
      "parameterNames": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "minItems": 1,
        "maxItems": 100
      },
      "outputFolder": {
        "type": "string",
        "maxLength": 520,
        "description": "Prefer omitting this field: the default is artifacts/xlsx inside the Operator workspace. A supplied folder must be under that workspace; a relative folder is recommended. Documents, Downloads and other external folders are rejected before writing."
      },
      "fileName": {
        "type": "string",
        "maxLength": 180,
        "description": "Simple unique workbook name, without directories. Existing destinations are never overwritten."
      },
      "dryRun": {
        "type": "boolean"
      },
      "supplementalTables": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 31,
              "minLength": 1
            },
            "contentKind": {
              "type": "string",
              "enum": [
                "user_input_transcription",
                "assistant_proposal",
                "review"
              ]
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 32
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "elementId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 8192
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "elementId",
                  "values"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 2000
            }
          },
          "required": [
            "name",
            "contentKind",
            "columns",
            "rows"
          ],
          "additionalProperties": false
        },
        "minItems": 0,
        "maxItems": 4,
        "description": "Every table, including review, must contain each selected elementId exactly once. Include a review row even for an element with no issues; put general notes into those rows instead of adding duplicate element rows. Each row has one scalar value per column. Preserve explicit zero versus unknown null. Values are assistant-authored, not native or verified engineering facts. Across all tables: at most 64000 cells and 1000000 text characters."
      }
    },
    "required": [
      "elementIds",
      "parameterNames"
    ],
    "additionalProperties": false
  },
