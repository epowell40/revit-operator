            },
            "minItems": 3,
            "maxItems": 3
          }
        ]
      },
      "connectorChanges": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "connectorId": {
              "type": "integer",
              "minimum": 0
            },
            "expectedOriginXyz": {
              "type": "array",
