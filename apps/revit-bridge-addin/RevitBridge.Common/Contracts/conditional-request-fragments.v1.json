          "maxItems": 3
        },
        "minItems": 2,
        "maxItems": 256
      },
      "startTangent": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        ]
      },
