<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\src\RevitOperator.SafeReadHost\Kernel\**\*.cs" Link="LegacyKernel\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RevitOperator.SafeReadHost\HostKernel\SafeReadContract.cs" Link="HostKernel\SafeReadContract.cs" />
    <Compile Include="..\..\src\RevitOperator.SafeReadHost\HostKernel\Protocol.cs" Link="HostKernel\Protocol.cs" />
    <Compile Include="..\..\src\RevitOperator.SafeReadHost\HostKernel\Admission.cs" Link="HostKernel\Admission.cs" />
    <Compile Include="..\..\src\RevitOperator.SafeReadHost\HostKernel\Responses.cs" Link="HostKernel\Responses.cs" />
    <Compile Include="..\..\src\RevitOperator.SafeReadHost\HostKernel\DiscoveryWire.cs" Link="HostKernel\DiscoveryWire.cs" />
    <Compile Include="..\..\src\RevitOperator.SafeReadHost\HostKernel\BackendAuthorization.cs" Link="HostKernel\BackendAuthorization.cs" />
    <Compile Include="..\..\src\RevitOperator.SafeReadHost\HostKernel\AuthorizationReceipts.cs" Link="HostKernel\AuthorizationReceipts.cs" />
    <Compile Include="..\..\src\RevitOperator.SafeReadHost\HostKernel\DocumentSession.cs" Link="HostKernel\DocumentSession.cs" />
    <Compile Include="..\..\src\RevitOperator.SafeReadHost\HostKernel\ExecutionContracts.cs" Link="HostKernel\ExecutionContracts.cs" />
    <Content Include="..\..\fixtures\**\*.json" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
