<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <AssemblyName>RevitOperator.SafeReadCertifiedExecution</AssemblyName>
    <RootNamespace>RevitOperator.SafeReadCertifiedExecution</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RevitYear Condition="'$(RevitYear)'=='' and '$(TargetFramework)'=='net48'">2024</RevitYear>
    <RevitYear Condition="'$(RevitYear)'=='' and '$(TargetFramework)'=='net8.0-windows'">2025</RevitYear>
    <RevitApiPath>C:\Program Files\Autodesk\Revit $(RevitYear)</RevitApiPath>
    <OutputPath>bin\Revit$(RevitYear)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\Revit$(RevitYear)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitApiPath)\RevitAPI.dll</HintPath><Private>False</Private></Reference>
    <Compile Include="RevitCertifiedExecution.cs" />
  </ItemGroup>
  <Target Name="ValidateRevitTarget" BeforeTargets="ResolveReferences">
    <PropertyGroup><CertifiedCompileCount>@(Compile->Count())</CertifiedCompileCount></PropertyGroup>
    <Error Condition="'$(CertifiedCompileCount)'!='1' or '@(Compile)'!='RevitCertifiedExecution.cs'" Text="Certified execution must compile exactly RevitCertifiedExecution.cs and no other source." />
    <Error Condition="'$(TargetFramework)'=='net48' and '$(RevitYear)'!='2023' and '$(RevitYear)'!='2024'" Text="net48 requires RevitYear 2023 or 2024." />
    <Error Condition="'$(TargetFramework)'=='net8.0-windows' and '$(RevitYear)'!='2025'" Text="net8.0-windows requires RevitYear 2025." />
    <Error Condition="!Exists('$(RevitApiPath)\RevitAPI.dll')" Text="Revit API assembly was not found." />
  </Target>
</Project>
