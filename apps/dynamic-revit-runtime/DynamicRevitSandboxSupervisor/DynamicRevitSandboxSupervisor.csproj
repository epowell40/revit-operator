<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DynamicRevitSdk\DynamicRevitSdk.csproj" />
    <ProjectReference Include="..\DynamicRevit.RuntimePackaging\DynamicRevit.RuntimePackaging.csproj" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\manifests\revit-host-capabilities.v1.json" Link="manifests\revit-host-capabilities.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\manifests\sandbox-policy.v1.json" Link="manifests\sandbox-policy.v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
