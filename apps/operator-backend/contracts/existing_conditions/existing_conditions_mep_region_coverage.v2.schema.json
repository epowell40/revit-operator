{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimtools.com/schemas/revit-operator/existing-conditions-mep-region-coverage.v2.schema.json",
  "title": "Bounded MEP region coverage V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "source_evidence_sha256",
    "registered_render_sha256",
    "coordinate_space",
    "region",
    "disciplines",
    "candidates"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "scope_id": { "type": "string", "minLength": 1 },
    "source_evidence_sha256": { "$ref": "https://bimtools.com/schemas/revit-operator/existing-conditions-architectural-preview.v1.schema.json#/$defs/sha256" },
    "registered_render_sha256": { "$ref": "https://bimtools.com/schemas/revit-operator/existing-conditions-architectural-preview.v1.schema.json#/$defs/sha256" },
    "coordinate_space": { "const": "registered_render_pixels_top_left" },
    "region": { "$ref": "https://bimtools.com/schemas/revit-operator/existing-conditions-mep-region-coverage.v1.schema.json#/$defs/bounds" },
    "scope_polygon": {
      "type": "array",
      "minItems": 3,
      "maxItems": 128,
      "items": { "$ref": "https://bimtools.com/schemas/revit-operator/existing-conditions-mep-region-coverage.v1.schema.json#/$defs/point" }
    },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["mechanical", "plumbing", "electrical"] }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "evidence", "symbol_count", "clipped_by_region"],
      "properties": {
        "kind": {
          "enum": [
            "single_model_symbol",
            "multi_symbol_cluster",
            "annotation_cluster",
            "linear_model_primitive",
            "junction_model_primitive",
            "unknown"
          ]
        },
        "role": {
          "enum": [
            "duct_route",
            "conduit_route",
            "air_terminal",
            "mechanical_equipment",
            "pipe_route",
            "plumbing_fixture",
            "electrical_device",
            "light_fixture",
            "lighting_device",
            "electrical_equipment",
            "electrical_circuit",
            "device_tag",
            "leader",
            "unknown"
          ]
        },
        "evidence": {
          "enum": ["direct_symbol_geometry", "leader_endpoint", "text_only", "mixed_or_overlapped"]
        },
        "symbol_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "clipped_by_region": { "type": "boolean" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "primitive", "pixel_bounds", "visibility", "representation", "disposition"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "primitive": { "enum": ["point_symbol", "linear_trace", "junction", "circuit_annotation", "unknown"] },
        "pixel_bounds": { "$ref": "https://bimtools.com/schemas/revit-operator/existing-conditions-mep-region-coverage.v1.schema.json#/$defs/bounds" },
        "scope_point": { "$ref": "https://bimtools.com/schemas/revit-operator/existing-conditions-mep-region-coverage.v1.schema.json#/$defs/point" },
        "scope_anchor_candidate_id": { "type": "string", "minLength": 1 },
        "visibility": { "enum": ["clear", "partial", "occluded"] },
        "representation": { "$ref": "#/$defs/representation" },
        "disposition": {
          "oneOf": [
            { "$ref": "https://bimtools.com/schemas/revit-operator/existing-conditions-mep-region-coverage.v1.schema.json#/$defs/resolved" },
            { "$ref": "https://bimtools.com/schemas/revit-operator/existing-conditions-mep-region-coverage.v1.schema.json#/$defs/unresolved" }
          ]
        }
      }
    }
  }
}
