{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimtools.com/schemas/revit-operator/existing-conditions-candidate.v2.schema.json",
  "title": "Existing conditions reconstruction candidate V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "scope_id", "visible_evidence", "accessed_artifact_roles", "out_of_scope_changed_element_keys", "snapshot", "visual_receipt"],
  "properties": {
    "schema_version": { "const": 2 },
    "fixture_id": { "type": "string", "minLength": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "discipline": { "type": "string", "enum": ["mechanical", "plumbing", "electrical", "architectural", "mixed", "other"] },
    "visible_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "accessed_artifact_roles": { "$ref": "#/$defs/strings" },
    "out_of_scope_changed_element_keys": { "$ref": "#/$defs/strings" },
    "evaluator_change_receipt": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["native_diff_readback", "changed_element_keys", "out_of_scope_changed_element_keys", "receipt_sha256"],
      "properties": {
        "native_diff_readback": { "const": true },
        "changed_element_keys": { "$ref": "#/$defs/strings" },
        "out_of_scope_changed_element_keys": { "$ref": "#/$defs/strings" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_coverage_receipt": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schema_version", "scope_id", "source_evidence_sha256", "registered_render_sha256", "coordinate_space", "region", "region_sha256", "coverage_contract_sha256", "coverage_status", "disciplines", "candidate_count", "resolved_candidate_ids", "unresolved_candidate_ids", "covered_observation_ids"],
      "properties": {
        "schema_version": { "const": 1 },
        "scope_id": { "type": "string", "minLength": 1 },
        "source_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "registered_render_sha256": { "$ref": "#/$defs/sha256" },
        "coordinate_space": { "const": "registered_render_pixels_top_left" },
        "region": { "$ref": "#/$defs/pixel_bounds" },
        "region_sha256": { "$ref": "#/$defs/sha256" },
        "coverage_contract_sha256": { "$ref": "#/$defs/sha256" },
        "coverage_status": { "enum": ["complete", "partial"] },
        "disciplines": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["mechanical", "plumbing", "electrical"] } },
        "candidate_count": { "type": "integer", "minimum": 1 },
        "resolved_candidate_ids": { "$ref": "#/$defs/strings" },
        "unresolved_candidate_ids": { "$ref": "#/$defs/strings" },
        "covered_observation_ids": { "$ref": "#/$defs/strings" }
      }
    },
    "snapshot": { "$ref": "existing-conditions-ground-truth.v1.schema.json#/$defs/snapshot" },
    "visual_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_scope_root", "workflow_fingerprint_sha256", "action_id", "attempt_id", "capture_nonce", "post_apply_completed_at", "issued_at", "post_change_capture_sha256", "post_change_pdf_sha256", "post_change_capture_artifact", "post_change_pdf_artifact", "evaluator_review", "evaluator_authority"],
      "properties": {
        "schema_version": { "const": 2 },
        "artifact_scope_root": { "type": "string", "minLength": 1 },
        "workflow_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "action_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "attempt_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "capture_nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "post_apply_completed_at": { "type": "string", "minLength": 20 },
        "issued_at": { "type": "string", "minLength": 20 },
        "post_change_capture_sha256": { "$ref": "#/$defs/sha256" },
        "post_change_pdf_sha256": { "$ref": "#/$defs/sha256" },
        "post_change_capture_artifact": { "$ref": "#/$defs/artifact" },
        "post_change_pdf_artifact": { "$ref": "#/$defs/artifact" },
        "evaluator_review": {
          "type": "object", "additionalProperties": false,
          "required": ["reviewer_role", "review_status", "notes"],
          "properties": {
            "reviewer_role": { "const": "evaluator" },
            "review_status": { "enum": ["pass", "needs_review", "fail"] },
            "notes": { "$ref": "#/$defs/strings" }
          }
        },
        "evaluator_authority": {
          "type": "object", "additionalProperties": false,
          "required": ["boundary", "algorithm", "key_id", "signature"],
          "properties": {
            "boundary": { "const": "trusted_hmac_verifier_v1" },
            "algorithm": { "const": "hmac-sha256" },
            "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "signature": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "pixel_point": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "pixel_bounds": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "$ref": "#/$defs/pixel_point" }, "max": { "$ref": "#/$defs/pixel_point" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["role", "sha256"], "properties": { "role": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "file_name", "sha256", "byte_length", "media_type", "modified_at"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "file_name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "media_type": { "enum": ["image", "application/pdf"] },
        "modified_at": { "type": "string", "minLength": 20 }
      }
    }
  }
}
