{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revitoperator.com/schemas/benchmark_raw_report.v2.schema.json",
  "title": "Benchmark Protocol V2 raw report",
  "type": "object",
  "required": ["schema", "envelope", "cases", "generated_at", "report_sha256"],
  "properties": {
    "schema": { "const": "revit-operator.benchmark-raw-report/v2" },
    "envelope": { "type": "object" },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "generated_at": { "type": "string", "minLength": 1 },
    "report_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  },
  "additionalProperties": false
}
