{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimtools.com/schemas/revit-operator/existing-conditions-ground-truth.v1.schema.json",
  "title": "Existing conditions withheld ground truth V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "scope_id", "ground_truth_model", "visible_evidence", "deletion_manifest", "snapshot"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixture_id": { "type": "string", "minLength": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "discipline": { "type": "string", "enum": ["mechanical", "plumbing", "electrical", "architectural", "mixed", "other"] },
    "ground_truth_model": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "visible_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "evaluation_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_evaluator_change_receipt": { "type": "boolean" },
        "elevation_evidence": { "enum": ["plan_visible", "project_context", "not_visible"] },
        "bounded_mep_region_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_coverage_status",
            "source_evidence_sha256",
            "registered_render_sha256",
            "coverage_contract_sha256",
            "region_sha256",
            "clear_plan_visible_family_instance_keys"
          ],
          "properties": {
            "required_coverage_status": { "const": "complete" },
            "source_evidence_sha256": { "$ref": "#/$defs/sha256" },
            "registered_render_sha256": { "$ref": "#/$defs/sha256" },
            "coverage_contract_sha256": { "$ref": "#/$defs/sha256" },
            "region_sha256": { "$ref": "#/$defs/sha256" },
            "clear_plan_visible_family_instance_keys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "deletion_manifest": {
      "type": "object", "additionalProperties": false, "required": ["requested_element_ids", "deleted_element_ids", "dependent_element_ids", "dry_run_receipt_sha256"],
      "properties": {
        "requested_element_ids": { "$ref": "#/$defs/ids" },
        "deleted_element_ids": { "$ref": "#/$defs/ids" },
        "dependent_element_ids": { "$ref": "#/$defs/ids" },
        "dry_run_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "snapshot": { "$ref": "#/$defs/snapshot" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "ids": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["role", "sha256"],
      "properties": { "role": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "point3": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
    },
    "element": {
      "type": "object", "required": ["key", "kind", "category"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["mep_curve", "linear_element", "fitting", "family_instance", "other"] },
        "discipline": { "type": "string", "enum": ["mechanical", "plumbing", "electrical", "architectural", "mixed", "other"] },
        "role": { "type": ["string", "null"] },
        "category": { "type": "string", "minLength": 1 },
        "family": { "type": ["string", "null"] },
        "type": { "type": ["string", "null"] },
        "system_classification": { "type": ["string", "null"] },
        "system_type": { "type": ["string", "null"] },
        "level_name": { "type": ["string", "null"] },
        "room_number": { "type": ["string", "null"] },
        "space_number": { "type": ["string", "null"] },
        "host_key": { "type": ["string", "null"] },
        "electrical": {
          "type": ["object", "null"],
          "properties": {
            "panel": { "type": ["string", "null"] },
            "circuit_number": { "type": ["string", "null"] },
            "primary_label": { "type": ["string", "null"] },
            "system_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "power_system_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "exact_power_system_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "location": { "oneOf": [{ "$ref": "#/$defs/point3" }, { "type": "null" }] },
        "endpoints": { "type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/point3" } }
      },
      "additionalProperties": true
    },
    "connection": {
      "type": "object", "additionalProperties": false, "required": ["a", "b"],
      "properties": {
        "a": { "type": "string", "minLength": 1 },
        "b": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["physical", "wall_junction", "host", "electrical_circuit", "system"] }
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false, "required": ["native_readback", "elements", "connections", "open_connector_count"],
      "properties": {
        "native_readback": { "const": true },
        "elements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/element" } },
        "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } },
        "open_connector_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
