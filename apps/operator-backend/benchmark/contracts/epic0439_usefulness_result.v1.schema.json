{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revitoperator.dev/contracts/epic0439_usefulness_result.v1.schema.json",
  "title": "EPIC-0439 usefulness result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "task_id", "config_id", "representation", "evidence_tier", "metrics", "failure", "notes"],
  "properties": {
    "schema_version": { "const": "epic0439_result/v1" },
    "case_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "config_id": { "enum": ["epic0439_typed_v1", "epic0439_dynamic_v1"] },
    "representation": { "enum": ["typed_capability_chain", "dynamic_program"] },
    "evidence_tier": { "enum": ["source_only", "mocked", "live_revit"] },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completion", "correctness", "changed_element_precision", "model_turns", "tool_rpc_calls", "generated_code_bytes", "execution_time_ms", "estimated_cost_usd", "input_tokens", "output_tokens", "preview_repairs", "verification_quality", "special_purpose_product_code_bytes", "recovery_attempts", "recovery_outcome"],
      "properties": {
        "completion": { "type": "boolean" },
        "correctness": { "type": "number", "minimum": 0, "maximum": 1 },
        "changed_element_precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "model_turns": { "type": "integer", "minimum": 0 },
        "tool_rpc_calls": { "type": "integer", "minimum": 0 },
        "generated_code_bytes": { "type": "integer", "minimum": 0 },
        "execution_time_ms": { "type": "number", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "preview_repairs": { "type": "integer", "minimum": 0 },
        "verification_quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "special_purpose_product_code_bytes": { "type": "integer", "minimum": 0 },
        "recovery_attempts": { "type": "integer", "minimum": 0 },
        "recovery_outcome": { "enum": ["not_needed", "recovered", "failed", "outcome_uncertain"] }
      }
    },
    "failure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "classification", "summary"],
          "properties": {
            "phase": { "enum": ["generation", "compile", "admission", "preview", "apply", "verification", "cleanup"] },
            "classification": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "live_revit_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "revit_version", "document_session_id", "admission_hash", "preview_receipt_hash", "apply_receipt_hash", "verification_receipt_hash"],
      "properties": {
        "receipt_id": { "type": "string", "minLength": 1 },
        "revit_version": { "type": "string", "minLength": 1 },
        "document_session_id": { "type": "string", "minLength": 1 },
        "admission_hash": { "type": "string", "minLength": 1 },
        "preview_receipt_hash": { "type": "string", "minLength": 1 },
        "apply_receipt_hash": { "type": "string", "minLength": 1 },
        "verification_receipt_hash": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "evidence_tier": { "const": "live_revit" } } },
      "then": { "required": ["live_revit_receipt"] },
      "else": { "not": { "required": ["live_revit_receipt"] } }
    }
  ]
}
