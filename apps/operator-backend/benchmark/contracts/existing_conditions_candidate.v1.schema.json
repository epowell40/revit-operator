{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimtools.com/schemas/revit-operator/existing-conditions-candidate.v1.schema.json",
  "title": "Existing conditions reconstruction candidate V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "scope_id", "visible_evidence", "accessed_artifact_roles", "out_of_scope_changed_element_keys", "snapshot", "visual_receipt"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixture_id": { "type": "string", "minLength": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "discipline": { "type": "string", "enum": ["mechanical", "plumbing", "electrical", "mixed", "other"] },
    "visible_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "accessed_artifact_roles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "out_of_scope_changed_element_keys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evaluator_change_receipt": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["native_diff_readback", "changed_element_keys", "out_of_scope_changed_element_keys", "receipt_sha256"],
      "properties": {
        "native_diff_readback": { "const": true },
        "changed_element_keys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "out_of_scope_changed_element_keys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "snapshot": { "$ref": "existing-conditions-ground-truth.v1.schema.json#/$defs/snapshot" },
    "visual_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["post_change_capture_sha256", "post_change_pdf_sha256", "evaluator_review"],
      "properties": {
        "post_change_capture_sha256": { "$ref": "#/$defs/sha256" },
        "post_change_pdf_sha256": { "$ref": "#/$defs/sha256" },
        "evaluator_review": {
          "type": "object", "additionalProperties": false,
          "required": ["reviewer_role", "review_status", "notes", "receipt_sha256"],
          "properties": {
            "reviewer_role": { "const": "evaluator" },
            "review_status": { "type": "string", "enum": ["pass", "needs_review", "fail"] },
            "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "receipt_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["role", "sha256"],
      "properties": { "role": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    }
  }
}
