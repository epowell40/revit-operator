{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimtools.com/schemas/revit-operator/existing-conditions-mep-region-coverage.v1.schema.json",
  "title": "Bounded MEP region coverage V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "source_evidence_sha256",
    "registered_render_sha256",
    "coordinate_space",
    "region",
    "disciplines",
    "candidates"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scope_id": { "type": "string", "minLength": 1 },
    "source_evidence_sha256": { "$ref": "https://bimtools.com/schemas/revit-operator/existing-conditions-architectural-preview.v1.schema.json#/$defs/sha256" },
    "registered_render_sha256": { "$ref": "https://bimtools.com/schemas/revit-operator/existing-conditions-architectural-preview.v1.schema.json#/$defs/sha256" },
    "coordinate_space": { "const": "registered_render_pixels_top_left" },
    "region": { "$ref": "#/$defs/bounds" },
    "scope_polygon": {
      "type": "array",
      "minItems": 3,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/point" }
    },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["mechanical", "plumbing", "electrical"] }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/point" },
        "max": { "$ref": "#/$defs/point" }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observation_ids"],
      "properties": {
        "status": { "const": "resolved" },
        "observation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "note"],
      "properties": {
        "status": { "const": "unresolved" },
        "reason": { "enum": ["ambiguous_symbol", "illegible_connectivity", "unresolved_member_classification", "occluded", "clipped_by_region"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "primitive", "pixel_bounds", "visibility", "disposition"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "primitive": { "enum": ["point_symbol", "linear_trace", "junction", "circuit_annotation", "unknown"] },
        "pixel_bounds": { "$ref": "#/$defs/bounds" },
        "scope_point": { "$ref": "#/$defs/point" },
        "scope_anchor_candidate_id": { "type": "string", "minLength": 1 },
        "visibility": { "enum": ["clear", "partial", "occluded"] },
        "disposition": {
          "oneOf": [
            { "$ref": "#/$defs/resolved" },
            { "$ref": "#/$defs/unresolved" }
          ]
        }
      }
    }
  }
}
