{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revitoperator.dev/contracts/epic0439_evidence_manifest.v1.schema.json",
  "title": "EPIC-0439 scorer evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "case_set_sha256", "entries"],
  "properties": {
    "schema_version": { "const": "epic0439_evidence_manifest/v1" },
    "suite_id": { "type": "string", "minLength": 1 },
    "case_set_sha256": { "$ref": "#/$defs/hash" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "nonNegativeNumber": { "type": "number", "minimum": 0 },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_turns", "tool_rpc_calls", "generated_code_bytes", "estimated_cost_usd",
        "input_tokens", "output_tokens", "preview_repairs",
        "special_purpose_product_code_bytes", "recovery_attempts"
      ],
      "properties": {
        "model_turns": { "$ref": "#/$defs/nonNegativeInteger" },
        "tool_rpc_calls": { "$ref": "#/$defs/nonNegativeInteger" },
        "generated_code_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "estimated_cost_usd": { "$ref": "#/$defs/nonNegativeNumber" },
        "input_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "output_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "preview_repairs": { "$ref": "#/$defs/nonNegativeInteger" },
        "special_purpose_product_code_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "recovery_attempts": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "task_id", "config_id", "representation",
        "evidence_file", "evidence_sha256", "telemetry"
      ],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "config_id": { "type": "string", "minLength": 1 },
        "representation": { "enum": ["typed_capability_chain", "dynamic_program"] },
        "evidence_file": { "type": "string", "minLength": 1 },
        "evidence_sha256": { "$ref": "#/$defs/hash" },
        "telemetry": { "$ref": "#/$defs/telemetry" }
      }
    }
  }
}
