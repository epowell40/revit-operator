{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimtools.com/schemas/revit-operator/existing-conditions-agent-package.v1.schema.json",
  "title": "Existing conditions agent-visible package V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "discipline", "task", "working_model", "evidence", "scope", "allowed_categories", "write_policy", "output_contract"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixture_id": { "type": "string", "minLength": 1 },
    "discipline": { "type": "string", "enum": ["mechanical", "plumbing", "electrical", "architectural", "mixed"] },
    "task": { "type": "string", "minLength": 1 },
    "working_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "type": "string", "enum": ["source_pdf", "source_pdf_render", "scope_preview", "surrounding_model_capture"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "page": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "view_id", "model_bounds_ft", "image_region_normalized"],
      "properties": {
        "scope_id": { "type": "string", "minLength": 1 },
        "view_id": { "type": "integer", "minimum": 1 },
        "sheet_number": { "type": ["string", "null"] },
        "model_bounds_ft": { "$ref": "#/$defs/bounds3" },
        "image_region_normalized": { "$ref": "#/$defs/rect" }
      }
    },
    "allowed_categories": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "write_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run_required", "bounded_scope_required", "out_of_scope_changes_allowed"],
      "properties": {
        "dry_run_required": { "const": true },
        "bounded_scope_required": { "const": true },
        "out_of_scope_changes_allowed": { "const": false },
        "maximum_created_elements": { "type": "integer", "minimum": 1 }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_snapshot_path", "post_change_capture_path", "post_change_pdf_path", "run_receipt_path"],
      "properties": {
        "candidate_snapshot_path": { "type": "string", "minLength": 1 },
        "post_change_capture_path": { "type": "string", "minLength": 1 },
        "post_change_pdf_path": { "type": "string", "minLength": 1 },
        "run_receipt_path": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "point3": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
    },
    "bounds3": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": { "min": { "$ref": "#/$defs/point3" }, "max": { "$ref": "#/$defs/point3" } }
    },
    "rect": {
      "type": "object", "additionalProperties": false, "required": ["min_x", "min_y", "max_x", "max_y"],
      "properties": {
        "min_x": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_y": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_x": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
