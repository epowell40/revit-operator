{
  "schema_version": 1,
  "task_id": "demo_documentation_primitives",
  "name": "Demo F: Documentation Primitives",
  "description": "Create and verify a bounded set of junior-designer documentation operations: schedule creation, schedule configuration, sheet creation, view creation, view template creation, view placement, view/template visibility settings, template category graphics overrides, CAD link/import evidence, text annotation, tagging, and cleanup for repeated live runs.",
  "environment": {
    "adapter_id": "revit_workflow",
    "app": "Revit",
    "metadata": {
      "workflow": "documentation_primitives"
    }
  },
  "setup_instructions": [
    "Open the target Revit model.",
    "Use unique benchmark-safe sheet and schedule names or let the workflow append the repeat suffix.",
    "Provide existing view/template ids only when overriding the default created drafting view and generated template.",
    "Provide tag element ids for at least one taggable element in the target view."
  ],
  "success_criteria": [
    "/revit/create-schedule dry-run succeeds and the apply call returns a schedule view id.",
    "/revit/configure-schedule dry-run succeeds and the apply response proves it targeted the created schedule id.",
    "/revit/create-sheet returns a sheet id and the requested sheet number.",
    "/revit/create-view dry-run and apply calls return a created view id.",
    "/revit/create-view creates a view template from the created view.",
    "/revit/place-view returns a created viewport id for the new view on the new sheet.",
    "/revit/draw-detail-curves dry-run succeeds and apply returns at least one annotation/detail curve id per requested curve.",
    "/revit/visibility dry-run succeeds and apply responses prove they targeted the created view and created template.",
    "/revit/visibility category override dry-run succeeds and the apply response proves the requested category lineweight was set in the target view.",
    "/revit/visibility view filter override dry-run succeeds and the apply response proves the requested filter visibility and lineweight were set in the target view.",
    "/revit/visibility view-template category override dry-run succeeds and the apply response proves the requested category lineweight was set in the created template.",
    "/revit/link-cad dry-run succeeds and apply returns a CAD link/import id, owner view id, and viewport id targeting the created sheet and requested source path.",
    "/revit/create-text reports success and a created text note id for a benchmark annotation.",
    "/revit/tag-elements dry-run succeeds and apply returns created tag ids covering all requested target elements.",
    "A post-change capture is produced before cleanup.",
    "A documentation primitives summary artifact is written.",
    "Created documentation primitives are proven in a cleanup dry-run and then deleted after evidence is recorded so repeated live runs do not accumulate schedules, sheets, views, annotations, or tags."
  ],
  "failure_criteria": [
    "Schedule dry-run fails or apply returns no schedule id.",
    "Schedule configuration dry-run fails, apply fails, or the apply response does not prove it targeted the created schedule id.",
    "Sheet creation returns no sheet id or the wrong sheet number.",
    "View or view-template creation returns no id.",
    "View placement does not return a viewport id.",
    "Detail curve dry-run or apply does not create enough annotation curve ids for the requested curves.",
    "Visibility dry-run fails, apply fails, or the apply response does not prove it targeted the created view/template.",
    "Category visibility override succeeds generically but does not report the requested category and lineweight.",
    "Filter visibility override succeeds generically but does not report the requested filter and lineweight.",
    "View-template category override succeeds generically but does not report the requested category and lineweight.",
    "CAD link/import succeeds generically but does not report the requested source path, created sheet id, owner view id, viewport id, or CAD element id.",
    "Text annotation does not return a created text note id.",
    "Tag element ids are missing or tagging does not return enough created tag ids to cover all requested targets.",
    "The post-change visual capture is missing before cleanup.",
    "Summary artifacts are missing.",
    "Cleanup is requested but created documentation ids are missing from the cleanup dry-run or applied delete evidence."
  ],
  "max_time_seconds": 120,
  "max_steps": 18,
  "requires_manual_grade": false,
  "grader_notes": [
    "This benchmark covers documentation/model-setup primitives, not redline spatial placement. Live runs are intentionally mutating and should use disposable benchmark names.",
    "The CAD link/import branch is the first benchmark shape for linked CAD graphics redlines; live runs need a real DWG fixture under the Revit Operator workspace or an explicitly allowed external root."
  ],
  "tags": ["revit", "demo", "documentation", "schedule", "sheet", "view", "visibility", "filter", "tag", "annotation", "deterministic"],
  "optional_ground_truth_artifact": null,
  "optional_cleanup_steps": [
    "Delete created schedules, sheets, views, view templates, viewports, detail curves, text notes, and tags after evidence is recorded."
  ],
