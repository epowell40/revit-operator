{
  "schema_version": 1,
  "task_id": "aec_mep_duct_route_vector_pdf",
  "name": "AEC-MEP V1 A: Duct Route From Vector PDF Redline",
  "description": "Replay a bounded duct-route pickup from explicit vector PDF redline geometry and verify the route workflow output.",
  "environment": {
    "adapter_id": "revit_workflow",
    "app": "Revit",
    "metadata": {
      "workflow": "aec_mep_eval",
      "scenario_kind": "duct_route_redline_vector_pdf"
    }
  },
  "setup_instructions": [
    "Use a prepared vector PDF redline whose route geometry is a target path, not a text underline.",
    "Map the vector route endpoints into the target Revit view before model writes.",
    "Use /revit/mep-route-workflow for dry-run/apply and post-change visual capture."
  ],
  "success_criteria": [
    "The eval records vector redline geometry as the source of the route.",
    "The route workflow returns the expected duct kind, size, created element evidence, and endpoint geometry.",
    "Post-change capture and open-connector reporting are present when applying."
  ],
  "failure_criteria": [
    "The route is derived from callout text or an underline instead of target path geometry.",
    "Created or planned route endpoints are outside tolerance.",
    "A model write is reported without post-change capture evidence."
  ],
  "max_time_seconds": 180,
  "max_steps": 4,
  "requires_manual_grade": false,
  "grader_notes": [
    "Live runs must inspect the returned visual capture before claiming user-ready completion."
  ],
  "tags": ["revit", "aec-mep", "eval", "redline", "duct", "deterministic"],
  "optional_ground_truth_artifact": null,
  "optional_cleanup_steps": [
    "Delete benchmark-created route elements when cleanupCreatedElements is true."
  ],
  "adapter_config": {
    "workflow": "aec_mep_eval",
    "request": {
