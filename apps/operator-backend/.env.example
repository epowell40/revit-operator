REVIT_OPERATOR_MODE=local
OPERATOR_API_BASE_URL=http://127.0.0.1:7007
OPERATOR_HOSTED_ENABLED=false
OPERATOR_OPENAI_API_KEY=
OPENAI_API_KEY=
OPERATOR_TOKEN=

# Large PDF/redline intake defaults.
OPERATOR_ATTACHMENT_UPLOAD_MAX_FILE_BYTES=104857600
OPERATOR_PDF_MAX_PAGES_DEFAULT=150
OPERATOR_PDF_MAX_PAGES_HARD_LIMIT=500
OPERATOR_PDF_VISION_BATCH_SIZE=8
# PDFs are rasterized by page range; individual Gemini image/request caps remain separate.
OPERATOR_GEMINI_MAX_PDF_INPUT_FILE_BYTES=209715200
