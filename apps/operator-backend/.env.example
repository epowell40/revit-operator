REVIT_OPERATOR_MODE=local
OPERATOR_API_BASE_URL=http://127.0.0.1:7007
OPERATOR_HOSTED_ENABLED=false
# Full shell-capable workbench is available only in explicit local/development mode
# and requires opt-in. Hosted, production, self-hosted, and unlabeled modes fence it off.
# OPERATOR_WORKBENCH_ENABLED=true
OPERATOR_OPENAI_API_KEY=
OPENAI_API_KEY=
OPERATOR_TOKEN=

# SafeRead runtime trust is mode-separated and fail-closed.
# Local/self-hosted/development use one canonical manifest and its exact content pin:
# OPERATOR_SAFE_READ_RUNTIME_ATTESTATION_SHA256=sha256:<64 lowercase hex>
# Effective hosted mode (REVIT_OPERATOR_MODE=hosted or OPERATOR_HOSTED_ENABLED=true)
# instead requires both separately pinned files below. Do not configure the legacy
# single-manifest pin in hosted mode. Example JSON files are inert/revoked public fixtures.
# OPERATOR_SAFE_READ_RUNTIME_ATTESTATION_SET_PATH=C:\absolute\path\safe_read_runtime_attestation_set.v1.json
# OPERATOR_SAFE_READ_RUNTIME_ATTESTATION_SET_SHA256=sha256:<64 lowercase hex>
# OPERATOR_SAFE_READ_ATTESTATION_TRUSTED_SIGNERS_PATH=C:\absolute\path\safe_read_attestation_trusted_signers.v1.json
# OPERATOR_SAFE_READ_ATTESTATION_TRUSTED_SIGNERS_SHA256=sha256:<64 lowercase hex>

# Optional primary planning brain. Keep real keys in .env.local.
# OPERATOR_BRAIN=gemini
# OPERATOR_GEMINI_API_KEY=
# GEMINI_API_KEY=
# OPERATOR_GEMINI_AGENT_MODEL=gemini-3.5-flash
# OPERATOR_GEMINI_AGENT_MODEL_FALLBACKS=gemini-3-flash-preview
# OPERATOR_GEMINI_AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPERATOR_GEMINI_AGENT_TIMEOUT_MS=180000
# OPERATOR_GEMINI_AGENT_MAX_OUTPUT_TOKENS=4096

# OPERATOR_BRAIN=anthropic
# OPERATOR_ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY=
# OPERATOR_ANTHROPIC_MODEL=claude-opus-4-8
# OPERATOR_ANTHROPIC_EFFORT=xhigh
# OPERATOR_ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPERATOR_ANTHROPIC_TIMEOUT_MS=180000
# OPERATOR_ANTHROPIC_MAX_OUTPUT_TOKENS=4096

# Bounded context controls shared by Gemini and Anthropic brains.
# OPERATOR_EXTERNAL_AGENT_MAX_HISTORY_MESSAGES=24
# OPERATOR_EXTERNAL_AGENT_MAX_PROMPT_CHARS=80000
# OPERATOR_EXTERNAL_AGENT_MAX_IMAGES=6

# Experimental Dynamic Revit provider execution is off by default. It is accepted
# only in exact development laboratory mode, and every path must be absolute.
# The provider supplies bounded source/config only; the trusted supervisor owns
# snapshot, sandboxing, admission, preview, fresh apply authorization, and receipts.
# OPERATOR_TOOL_EXPOSURE_PROFILE=laboratory
# OPERATOR_DYNAMIC_REVIT_PROGRAM_RUNNER=enabled
# OPERATOR_DYNAMIC_REVIT_SUPERVISOR_PATH=C:\absolute\runtime\DynamicRevitSandboxSupervisor.exe
# OPERATOR_DYNAMIC_REVIT_SUPERVISOR_SHA256=sha256:<64 lowercase hex characters>
# OPERATOR_DYNAMIC_REVIT_WORKER_DIRECTORY=C:\absolute\runtime
# OPERATOR_DYNAMIC_REVIT_WORKER_PACKAGE_SHA256=sha256:<64 lowercase hex characters>
# OPERATOR_DYNAMIC_REVIT_TOKEN_FILE=C:\absolute\RevitOperator\operator-token.txt
# OPERATOR_DYNAMIC_REVIT_BRIDGE_URL=http://127.0.0.1:5000

# Large PDF/redline intake defaults.
OPERATOR_ATTACHMENT_UPLOAD_MAX_FILE_BYTES=104857600
OPERATOR_PDF_MAX_PAGES_DEFAULT=150
OPERATOR_PDF_MAX_PAGES_HARD_LIMIT=500
OPERATOR_PDF_VISION_BATCH_SIZE=8
# PDFs are rasterized by page range; individual Gemini image/request caps remain separate.
OPERATOR_GEMINI_MAX_PDF_INPUT_FILE_BYTES=209715200
