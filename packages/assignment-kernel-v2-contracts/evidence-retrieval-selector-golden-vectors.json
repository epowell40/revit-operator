          "path": " rows ",
          "start": 0,
          "count": 9,
          "fields": [
            " id ",
            "geometry.start"
          ]
        }
      },
      "expected": {
        "kind": "item_range",
        "item_range": {
          "path": "rows",
          "start": 0,
          "count": 9,
          "fields": [
            "id",
            "geometry.start"
          ]
        }
      }
    },
    {
      "id": "retained-scalar-filter-order",
      "input": {
        "item_range": {
          "orderBy": {
            "field": "length",
            "direction": "desc"
          },
          "path": "payload.items",
          "fields": [
            "elementId",
            "length"
          ],
          "start": 0,
          "filters": [
            {
              "value": 0.5,
              "op": "eq",
              "field": "diameter"
            }
          ],
          "count": 2
        }
      },
      "expected": {
        "item_range": {
          "orderBy": {
            "field": "length",
            "direction": "desc"
          },
          "path": "payload.items",
          "fields": [
            "elementId",
            "length"
          ],
          "start": 0,
          "filters": [
            {
              "value": 0.5,
              "op": "eq",
              "field": "diameter"
            }
          ],
          "count": 2
        },
        "kind": "item_range"
      }
    },
    {
      "id": "nested-field-text-page",
      "input": {
        "text_range": {
          "path": "native_outcome.program_result",
          "start": 2048,
          "length": 1024
