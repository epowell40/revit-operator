{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revitoperator.dev/contracts/dynamic-runtime/admission.v1.schema.json",
  "title": "Dynamic Revit program admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "admission_id", "normalized_source_hash", "compiled_artifact_hash", "compiler_runtime_hash", "sdk_version",
    "sdk_manifest_hash", "sdk_artifact_hash", "worker_executable_hash", "worker_runtime_package_hash", "sandbox_profile_version",
    "sandbox_profile_hash", "authenticated_worker_identity_hash", "target_revit_version", "host_adapter_manifest_hash",
    "document_fingerprint", "document_session_id", "document_revision", "project_context_identity_hash", "capability_envelope_hash",
    "operation_family_envelope_hash", "effect_budget_hash", "file_capability_set_hash", "operation_graph_hash", "preview_receipt_hash",
    "policy_identity_hash", "runtime_identity_hash", "request_family_seal_hash", "final_authorization_hash", "principal_id_hash",
    "principal_session_hash", "correlation_id", "replay_nonce_hash", "issued_unix_seconds", "expires_unix_seconds", "admission_signature"
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }
  },
  "properties": {
    "schema": { "const": "dynamic_program_admission/v1" },
    "admission_id": { "$ref": "#/$defs/id" },
    "normalized_source_hash": { "$ref": "#/$defs/hash" },
    "compiled_artifact_hash": { "$ref": "#/$defs/hash" },
    "compiler_runtime_hash": { "$ref": "#/$defs/hash" },
    "sdk_version": { "const": "dynamic-revit-sdk/v1" },
    "sdk_manifest_hash": { "$ref": "#/$defs/hash" },
    "sdk_artifact_hash": { "$ref": "#/$defs/hash" },
    "worker_executable_hash": { "$ref": "#/$defs/hash" },
    "worker_runtime_package_hash": { "$ref": "#/$defs/hash" },
    "sandbox_profile_version": { "$ref": "#/$defs/id" },
    "sandbox_profile_hash": { "$ref": "#/$defs/hash" },
    "authenticated_worker_identity_hash": { "$ref": "#/$defs/hash" },
    "target_revit_version": { "enum": ["2023", "2024", "2025"] },
    "host_adapter_manifest_hash": { "$ref": "#/$defs/hash" },
    "document_fingerprint": { "$ref": "#/$defs/hash" },
    "document_session_id": { "$ref": "#/$defs/id" },
    "document_revision": { "type": "integer", "minimum": 0 },
    "project_context_identity_hash": { "$ref": "#/$defs/hash" },
    "capability_envelope_hash": { "$ref": "#/$defs/hash" },
    "operation_family_envelope_hash": { "$ref": "#/$defs/hash" },
    "effect_budget_hash": { "$ref": "#/$defs/hash" },
    "file_capability_set_hash": { "$ref": "#/$defs/hash" },
    "operation_graph_hash": { "$ref": "#/$defs/hash" },
    "preview_receipt_hash": { "$ref": "#/$defs/hash" },
    "policy_identity_hash": { "$ref": "#/$defs/hash" },
    "runtime_identity_hash": { "$ref": "#/$defs/hash" },
    "request_family_seal_hash": { "$ref": "#/$defs/hash" },
    "final_authorization_hash": { "$ref": "#/$defs/hash" },
    "principal_id_hash": { "$ref": "#/$defs/hash" },
    "principal_session_hash": { "$ref": "#/$defs/hash" },
    "correlation_id": { "$ref": "#/$defs/id" },
    "replay_nonce_hash": { "$ref": "#/$defs/hash" },
    "issued_unix_seconds": { "type": "integer", "minimum": 0 },
    "expires_unix_seconds": { "type": "integer", "minimum": 1 },
    "admission_signature": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" }
  }
}
