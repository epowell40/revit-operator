{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revitoperator.dev/contracts/dynamic-runtime/host-capabilities.v1.schema.json",
  "title": "Dynamic Revit host capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [ "schema", "manifestVersion", "protocolVersion", "hosts" ],
  "properties": {
    "schema": { "const": "dynamic-revit-host-capabilities/v1" },
    "manifestVersion": { "type": "string", "minLength": 1 },
    "protocolVersion": { "type": "string", "minLength": 1 },
    "hosts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "revitYear", "targetFramework", "installDirectoryName", "executableName", "hostArtifactRelativePath", "sdkDomains" ],
        "properties": {
          "revitYear": { "enum": [ "2023", "2024", "2025" ] },
          "targetFramework": { "enum": [ "net48", "net8.0-windows" ] },
          "installDirectoryName": { "enum": [ "Revit 2023", "Revit 2024", "Revit 2025" ] },
          "executableName": { "const": "Revit.exe" },
          "hostArtifactRelativePath": { "type": "string", "pattern": "^hosts/(2023|2024|2025)/DynamicRevitHost\\.dll$" },
          "sdkDomains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
